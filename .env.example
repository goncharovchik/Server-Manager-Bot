# Telegram Bot Token (получить у @BotFather)
BOT_TOKEN=your_bot_token_here

# Telegram ID администраторов (через запятую)
ADMIN_IDS=123456789,987654321

# Максимум команд в минуту (по умолчанию 30)
RATE_LIMIT=30

# Уровень логирования: error, warn, info, debug
LOG_LEVEL=info

# Директория для бэкапов
BACKUP_DIR=/var/backups/vds_bot

# ВАЖНО: бот должен запускаться от root или пользователя с NOPASSWD в sudoers,
# т.к. exec не поддерживает интерактивный ввод пароля sudo.
# Пример sudoers: botuser ALL=(ALL) NOPASSWD: ALL

# Запуск:
#   Локально:       npm start
#   Docker Compose:  docker compose up -d
#   Docker-режим определяется автоматически (nsenter для хостовых команд)


